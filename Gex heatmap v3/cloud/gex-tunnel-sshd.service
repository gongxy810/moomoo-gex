[Unit]
Description=Private Tailscale-only OpenD forwarding endpoint
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/gex-tunnel-sshd.conf
ExecStart=/usr/sbin/sshd -D -f /etc/ssh/gex-tunnel-sshd.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
