//@version=6
indicator("Gex heatmap v2 · OpenD snapshot", overlay = true, max_lines_count = 50, max_labels_count = 100)

// Paste the GEX2 block from the board's Export gex levels dialog.
// Pine cannot read the local OpenD service. This is one captured snapshot, not a live feed.
string snapshot = input.text_area("", "Snapshot input (GEX2)", group = "Board data")
bool showBubbles = input.bool(true, "Important GEX bubbles", group = "Display")
bool showRange = input.bool(true, "Fixed Day Expected Range", group = "Display")
bool showSummary = input.bool(true, "Snapshot summary", group = "Display")

color gold = #E9BA48
color purple = #8738D1
color kingGold = #D5B754
color callCyan = #55BACE
color putPink = #D579B5
color bothWall = #A88EB8
color rangeBlue = #699BD0
color panel = #141319
color quiet = #A9A3B2

var string sourceSymbol = ""
var string sourceDate = ""
var string capturedAt = ""
var string expiries = ""
var float putWall = na
var float callWall = na
var float low1 = na
var float high1 = na
var float kingPrice = na
var float netGex = na
var float callGex = na
var float putGex = na
var float referencePrice = na
var string referenceKind = ""
var bool parsed = false
var array<float> nodeStrikes = array.new<float>()
var array<float> nodeGex = array.new<float>()
var array<float> nodePercent = array.new<float>()
var array<line> drawnLines = array.new<line>()
var array<label> drawnLabels = array.new<label>()
var table summary = table.new(position.top_right, 2, 7, bgcolor = panel, border_width = 1, border_color = #35323D)

if barstate.isfirst
    array<string> records = str.split(snapshot, "\n")
    if array.size(records) > 0
        array<string> fields = str.split(str.trim(array.get(records, 0)), "|")
        if array.size(fields) == 15 and array.get(fields, 0) == "GEX2"
            sourceSymbol := str.trim(array.get(fields, 1))
            sourceDate := str.trim(array.get(fields, 2))
            putWall := str.tonumber(array.get(fields, 3))
            callWall := str.tonumber(array.get(fields, 4))
            low1 := str.tonumber(array.get(fields, 5))
            high1 := str.tonumber(array.get(fields, 6))
            kingPrice := str.tonumber(array.get(fields, 7))
            capturedAt := str.trim(array.get(fields, 8))
            expiries := str.trim(array.get(fields, 9))
            netGex := str.tonumber(array.get(fields, 10))
            callGex := str.tonumber(array.get(fields, 11))
            putGex := str.tonumber(array.get(fields, 12))
            referencePrice := str.tonumber(array.get(fields, 13))
            referenceKind := str.trim(array.get(fields, 14))
            parsed := str.length(sourceDate) == 8 and not na(putWall) and not na(callWall) and not na(kingPrice)
            if parsed and array.size(records) > 1
                for i = 1 to math.min(array.size(records) - 1, 20)
                    array<string> level = str.split(str.trim(array.get(records, i)), "|")
                    if array.size(level) == 4 and array.get(level, 0) == "L"
                        float strike = str.tonumber(array.get(level, 1))
                        float value = str.tonumber(array.get(level, 2))
                        float percent = str.tonumber(array.get(level, 3))
                        if not na(strike) and not na(value) and not na(percent)
                            array.push(nodeStrikes, strike)
                            array.push(nodeGex, value)
                            array.push(nodePercent, percent)

// SPXW strikes live on the cash SPX axis. Never draw them on FOREXCOM:SPXUSD CFD.
bool symbolMatches = parsed and (sourceSymbol == "SPXW" ? (syminfo.tickerid == "TVC:SPX" or syminfo.tickerid == "CBOE:SPX") : syminfo.ticker == sourceSymbol)
bool dateMatches = parsed and str.format_time(time, "yyyyMMdd", "America/New_York") == sourceDate
bool matchBar = symbolMatches and dateMatches
var int firstMatchBar = na
if matchBar and not matchBar[1]
    firstMatchBar := bar_index

if barstate.islast
    for oldLine in drawnLines
        line.delete(oldLine)
    array.clear(drawnLines)
    for oldLabel in drawnLabels
        label.delete(oldLabel)
    array.clear(drawnLabels)

    if matchBar and not na(firstMatchBar)
        bool sameWall = putWall == callWall
        array<float> prices = array.from(putWall, sameWall ? na : callWall, kingPrice, showRange ? low1 : na, showRange ? high1 : na, referencePrice)
        array<string> names = array.from(sameWall ? "C/P Wall" : "Put Wall", "Call Wall", "★ King", "Day −1σ", "Day +1σ", referenceKind + " @capture")
        array<color> tones = array.from(sameWall ? bothWall : putPink, callCyan, kingGold, rangeBlue, rangeBlue, quiet)
        for i = 0 to array.size(prices) - 1
            float levelPrice = array.get(prices, i)
            if not na(levelPrice) and levelPrice > 0
                color tone = array.get(tones, i)
                bool dashed = i != 2
                line ln = line.new(firstMatchBar, levelPrice, bar_index + 7, levelPrice, xloc = xloc.bar_index, extend = extend.none, color = color.new(tone, i >= 3 ? 35 : 8), style = dashed ? line.style_dashed : line.style_solid, width = i == 2 ? 2 : 1)
                array.push(drawnLines, ln)
                string caption = array.get(names, i) + "  " + str.tostring(levelPrice, format.mintick)
                label tag = label.new(bar_index + 7, levelPrice, caption, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(tone, 15), style = label.style_label_left, textcolor = #0B0B0D, size = size.tiny, tooltip = "OpenD GEX snapshot " + capturedAt + "\nExpiry: " + expiries)
                array.push(drawnLabels, tag)
        if showBubbles and array.size(nodeStrikes) > 0
            for i = 0 to array.size(nodeStrikes) - 1
                float strike = array.get(nodeStrikes, i)
                float value = array.get(nodeGex, i)
                float percent = math.min(100, math.max(0, array.get(nodePercent, i)))
                color nodeTone = value >= 0 ? gold : purple
                int fade = int(math.round(90 - 0.55 * percent))
                string details = "Native OpenD GEX\nStrike " + str.tostring(strike, format.mintick) + "\nGEX " + str.tostring(value, "#.####") + "\n" + str.tostring(percent, "#.##") + "% of strongest\nCaptured " + capturedAt + "\nExpiry " + expiries
                label bubble = label.new(bar_index + 1, strike, " ", xloc = xloc.bar_index, yloc = yloc.price, color = color.new(nodeTone, fade), style = label.style_circle, textcolor = nodeTone, size = percent >= 70 ? size.normal : percent >= 35 ? size.small : size.tiny, tooltip = details)
                array.push(drawnLabels, bubble)
                label textTag = label.new(bar_index + 2, strike, (value >= 0 ? "+" : "−") + str.tostring(strike, format.mintick) + "  " + str.tostring(percent, "#.0") + "%", xloc = xloc.bar_index, yloc = yloc.price, color = color.new(panel, 10), style = label.style_label_left, textcolor = nodeTone, size = size.tiny, tooltip = details)
                array.push(drawnLabels, textTag)

    if showSummary
        string status = not parsed ? "Paste GEX2 export" : not symbolMatches ? "Symbol mismatch · " + sourceSymbol : not dateMatches ? "Date mismatch · " + sourceDate : "Snapshot levels"
        color statusTone = matchBar ? gold : putPink
        table.cell(summary, 0, 0, "GEX HEATMAP V2", text_color = gold, text_size = size.small)
        table.cell(summary, 1, 0, status, text_color = statusTone, text_size = size.tiny)
        table.cell(summary, 0, 1, "Source / date", text_color = quiet, text_size = size.tiny)
        table.cell(summary, 1, 1, sourceSymbol + " · " + sourceDate, text_color = #DFDCE2, text_size = size.tiny)
        table.cell(summary, 0, 2, "Captured", text_color = quiet, text_size = size.tiny)
        table.cell(summary, 1, 2, capturedAt, text_color = #DFDCE2, text_size = size.tiny)
        table.cell(summary, 0, 3, "Expiry", text_color = quiet, text_size = size.tiny)
        table.cell(summary, 1, 3, expiries, text_color = #DFDCE2, text_size = size.tiny)
        table.cell(summary, 0, 4, "Net / Call / Put", text_color = quiet, text_size = size.tiny)
        table.cell(summary, 1, 4, str.tostring(netGex, format.volume) + " / " + str.tostring(callGex, format.volume) + " / " + str.tostring(putGex, format.volume), text_color = #DFDCE2, text_size = size.tiny)
        table.cell(summary, 0, 5, "Spot / REF", text_color = quiet, text_size = size.tiny)
        table.cell(summary, 1, 5, referenceKind + " " + str.tostring(referencePrice, format.mintick), text_color = quiet, text_size = size.tiny)
        table.cell(summary, 0, 6, "Day range", text_color = quiet, text_size = size.tiny)
        table.cell(summary, 1, 6, na(low1) or na(high1) ? "Unavailable" : str.tostring(low1, format.mintick) + "–" + str.tostring(high1, format.mintick), text_color = rangeBlue, text_size = size.tiny)
    else
        table.clear(summary, 0, 0, 1, 6)

